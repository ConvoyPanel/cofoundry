#cloud-config
autoinstall:
  version: 1
  locale: en_US.UTF-8
  keyboard:
    layout: us
  network:
    version: 2
    ethernets:
      id0:
        match:
          name: "en*"
        addresses:
          - __PACKER_BUILD_IP__/24
        routes:
          - to: default
            via: __PACKER_BUILD_GW__
        nameservers:
          addresses:
            - __PACKER_BUILD_DNS__
  # The build's ephemeral SSH key is installed for the packer user in a
  # late-command (below), never through the autoinstall `ssh:` section.
  # Subiquity's `ssh.authorized-keys` registers the key as an instance public
  # key, which cloud-init then also plants in /root/.ssh/authorized_keys as a
  # neutered disable_root stub — the build key leaking into the shipped
  # template. Injecting it per-user keeps it off root entirely and matches the
  # Debian preseed and AlmaLinux/Rocky kickstart flows.
  identity:
    realname: packer
    username: packer
    hostname: packer-ubuntu
    # Locked: packer authenticates by key only and is deleted before the
    # template is exported. Mirrors the preseed's `passwd/user-password-crypted !`.
    password: "!"
  # grub-efi-amd64-signed and shim-signed make the image boot under UEFI with
  # Secure Boot as well as BIOS, beside the grub-pc the BIOS-booted installer
  # puts in. The official cloud images carry all three. The live server ISO's
  # pool has both, since it installs them on UEFI machines.
  packages:
    - qemu-guest-agent
    - openssh-server
    - grub-efi-amd64-signed
    - shim-signed
  # The kernel the official cloud images run: the generic kernel without
  # linux-modules-extra and the ~700 MB of bare-metal firmware linux-generic
  # pulls in. finalize.sh removes whatever the installer pool added besides.
  kernel:
    package: linux-virtual
  # archive.ubuntu.com, not the country mirror the installer's location lookup
  # picks from wherever the build node happens to be.
  apt:
    geoip: false
  # The official cloud image's layout, which boots under BIOS and UEFI: GPT, a
  # BIOS boot partition for grub-pc's core image, a FAT32 EFI system
  # partition, and the ext4 root last, so growpart can extend it to fill
  # whatever disk a clone gets. No swap partition, for the same reason.
  # `grub_device` on the disk is where curtin installs grub-pc, since the
  # installer runs under BIOS; the EFI loader goes in by late-command below.
  storage:
    swap:
      size: 0
    config:
      - type: disk
        id: disk0
        match:
          size: largest
        ptable: gpt
        wipe: superblock-recursive
        preserve: false
        grub_device: true
      - type: partition
        id: bios-boot
        device: disk0
        number: 1
        size: 1M
        flag: bios_grub
        preserve: false
      - type: partition
        id: esp
        device: disk0
        number: 2
        size: 106M
        flag: boot
        preserve: false
      - type: partition
        id: root
        device: disk0
        number: 3
        size: -1
        preserve: false
      - type: format
        id: esp-fs
        volume: esp
        fstype: fat32
        preserve: false
      - type: format
        id: root-fs
        volume: root
        fstype: ext4
        preserve: false
      - type: mount
        id: root-mount
        device: root-fs
        path: /
      - type: mount
        id: esp-mount
        device: esp-fs
        path: /boot/efi
        options: umask=0077
  late-commands:
    - curtin in-target -- bash -c "echo 'GRUB_CMDLINE_LINUX=\"console=tty0 console=ttyS0,115200\"' > /etc/default/grub.d/50-cofoundry.cfg"
    # GRUB for UEFI, as the official cloud images install it: the signed
    # loader behind shim, no boot entry (each clone's variable store is new,
    # so the firmware finds shim at the removable path, EFI/BOOT/BOOTX64.EFI).
    # The cloud_style_installation answers make grub-pc and
    # grub-efi-amd64-signed reinstall to the disk and ESP holding /boot on
    # every upgrade, instead of to the build VM's disk recorded in debconf;
    # 22.04's GRUB does not have them, and there the first boot's cloud-init
    # (grub_dpkg) points both at the clone's own disk.
    - curtin in-target -- bash -c "printf '%s\n' 'grub-pc grub-pc/cloud_style_installation boolean true' 'grub-pc grub-efi/cloud_style_installation boolean true' | debconf-set-selections"
    # Single-quoted so the $(...) runs in the target, against its grub-install.
    - curtin in-target -- bash -c 'grub-install --target=x86_64-efi --efi-directory=/boot/efi --uefi-secure-boot --no-nvram $(grub-install --help | grep -q -- --force-extra-removable && echo --force-extra-removable)'
    - curtin in-target -- update-grub
    # Serialize the two units that mutate /boot/grub/grubenv.
    #
    # 26.04 renamed grub-common.service to grub2-common.service but left
    # grub-initrd-fallback.service ordered `After=grub-common.service`. An
    # After= naming a unit that does not exist is silently no ordering at all,
    # so on 26.04 both units run at boot-complete.target concurrently — and
    # both call grub-editenv, which rewrites the block via fopen(..., "wb").
    # The truncate window makes a concurrent reader see a short block and die
    # with "invalid environment block"; the guest then boots `degraded`.
    # Measured in the shipped 26.04 image: 25/200 concurrent pairs failed,
    # 0/400 sequential.
    #
    # Both spellings are listed because the family shares one payload: on
    # releases still using the old name the grub2- line is inert, and on 26.04
    # the grub- line is. That inertness is exactly the bug's mechanism, used
    # here in the other direction. See docs/recipes.md#ubuntu-grubenv-race.
    - curtin in-target -- mkdir -p /etc/systemd/system/grub-initrd-fallback.service.d
    - curtin in-target -- bash -c "printf '[Unit]\\nAfter=grub-common.service\\nAfter=grub2-common.service\\n' > /etc/systemd/system/grub-initrd-fallback.service.d/10-cofoundry-grubenv-race.conf"
    - curtin in-target -- bash -c "mkdir -p /etc/ssh/sshd_config.d && printf 'PermitRootLogin yes\\nPasswordAuthentication yes\\n' > /etc/ssh/sshd_config.d/10-cofoundry.conf"
    # Subiquity defers the identity user to cloud-init's first boot, so `packer`
    # does not yet exist in the target when these late-commands run — confirmed
    # on a live 22.04/25.10 build where the `-o packer` install below failed
    # "invalid user 'packer'" and aborted the whole autoinstall (30-min SSH
    # timeout: installer sshd up, no packer key). Create the group and user
    # in-target first; cloud-init reconciles the pre-existing user idempotently
    # on first boot. See docs/recipes.md#ubuntu-autoinstall.
    - curtin in-target -- bash -c "getent group packer >/dev/null || groupadd packer"
    - curtin in-target -- bash -c "id -u packer >/dev/null 2>&1 || useradd --create-home --gid packer --shell /bin/bash packer"
    # Install the ephemeral build key for packer only — deliberately not root.
    - curtin in-target -- install -d -m 700 -o packer -g packer /home/packer/.ssh
    - curtin in-target -- bash -c "echo '__PACKER_SSH_PUBLIC_KEY__' > /home/packer/.ssh/authorized_keys"
    - curtin in-target -- chmod 600 /home/packer/.ssh/authorized_keys
    - curtin in-target -- chown packer:packer /home/packer/.ssh/authorized_keys
    - curtin in-target -- usermod -aG adm,sudo packer
    - curtin in-target -- bash -c "echo 'packer ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/packer"
    - curtin in-target -- chmod 440 /etc/sudoers.d/packer
